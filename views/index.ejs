<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Card Guessing Game</title>
    <link rel="stylesheet" href="/css/style.css" />
    <style>
      #game-container {
        display: flex;
        gap: 20px;
      }
      #instructions {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        flex: 1;
        padding: 20px;
      }
      .btn {
        margin-top: 10px;
        padding: 10px 15px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
      }
      .btn:hover {
        background-color: #0056b3;
      }
    </style>
  </head>
  <body>
    <h1>Programming Languages Card Guessing Game</h1>
    <div id="username-container">
      <form id="username-form">
        <label for="username-input">Enter your username:</label>
        <input type="text" id="username-input" name="username" required />
        <button type="submit" class="btn">Start Game</button>
      </form>
    </div>

    <div id="game-container" style="display: none">
      <div id="game">
        <div id="timer">Time: 00:00:00</div>
        <div id="game-board"></div>
        <button id="reset" class="btn">Reset Game</button>
        <a href="/scores" class="btn">View Scores</a>
        <form action="/submit-score" method="POST" id="submit-score-form">
          <input type="hidden" name="username" id="username" />
          <input type="hidden" name="time" id="time" />
          <button type="submit" class="btn">Submit Score</button>
        </form>
      </div>

      <div id="instructions">
        <h2>How to Play</h2>
        <ol>
          <li>Enter your username and click "Start Game" to begin.</li>
          <li>Flip two cards at a time to find a matching pair.</li>
          <li>
            If the cards match, they remain flipped. Otherwise, they turn back
            over.
          </li>
          <li>
            Complete the game as quickly as possible to get a better score.
          </li>
          <li>
            Submit your score once you finish the game(YOU WONT BE ABLE TO
            SUBMIT IF YOU DONT FINISH THE GAME)!!!
          </li>
        </ol>
        <h2>Highest Score</h2>
        <p id="highest-score">Fetching...</p>
      </div>
    </div>

    <script src="/js/game.js"></script>
    <script>
      const timerElement = document.getElementById("timer");
      const timeInput = document.getElementById("time");
      const totalPairs = document.querySelectorAll(".card").length / 2;

      let timer;
      let matchedPairs = 0;
      let elapsedTime = 0;
      let timerDisplay = "Time: 0s";

      function startTimer() {
        stopTimer(); // Clear any existing timer
        timerInterval = setInterval(() => {
          elapsedTime++;
        }, 1000);
      }

      function stopTimer() {
        clearInterval(timer);
      }

      const submitButton = document
        .getElementById("submit-score-form")
        .querySelector("button");
      submitButton.disabled = true;

      document
        .getElementById("username-form")
        .addEventListener("submit", (e) => {
          e.preventDefault();
          const username = document
            .getElementById("username-input")
            .value.trim();
          if (!username) {
            alert("Please enter a valid username.");
            return;
          }
          document.getElementById("username").value = username;
          document.getElementById("username-container").style.display = "none";
          document.getElementById("game-container").style.display = "flex";
          startTimer();
        });

      const getScores = () => {
        try {
          const data = fs.readFileSync(dbPath, "utf8");
          return JSON.parse(data.scores || []).filter(
            (score) => score.username && typeof score.time === "number"
          ); // Ensure the 'scores' key is present
        } catch (error) {
          console.error("Error reading db.json:", error);
          return [];
        }
      };

      const saveScores = (scores) => {
        try {
          const data = JSON.stringify({ scores }, null, 2); // Pretty print JSON with indentation
          fs.writeFileSync(dbPath, data, "utf8");
          console.log("Scores saved to db.json");
        } catch (error) {
          console.error("Error writing to db.json:", error);
        }
      };

      document
        .getElementById("submit-score-form")
        .addEventListener("submit", (e) => {
          e.preventDefault(); // Prevent form submission

          const username = document.getElementById("username").value;
          const timeText = document.getElementById("timer").textContent;

          // Extract time in seconds from "Time: XX:XX:XX"
          const timeParts = timeText.split(" ")[1].split(":");
          const time =
            parseInt(timeParts[0]) * 60 * 60 +
            parseInt(timeParts[1]) * 60 +
            parseInt(timeParts[2]);

          fetch("http://localhost:3000/submit-score", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ username, time }), // Include parsed time
          })
            .then((response) => response.json())
            .then((data) => {
              alert(data.message);
            })
            .catch((error) => {
              alert(error.message); // Handle errors
            });
        });

      fetch("http://localhost:3000/highest-score")
        .then((response) => response.json())
        .then((data) => {
          document.getElementById(
            "highest-score"
          ).textContent = `${data.username}: ${data.time} seconds`;
        })
        .catch(() => {
          document.getElementById("highest-score").textContent =
            "No scores yet.";
        });
      const checkMatch = () => {
        if (firstCard.dataset.value === secondCard.dataset.value) {
          matchedPairs++;
          if (matchedPairs === programmingLanguages.length / 2) {
            stopTimer();
            alert(
              "You’ve matched all the programming languages! Well done! Submit your score"
            );
            submitButton.disabled = false;
          }
          firstCard = secondCard = null;
        } else {
          setTimeout(() => {
            firstCard.classList.remove("flipped");
            secondCard.classList.remove("flipped");
            firstCard = secondCard = null;
          }, 1000);
        }
      };
    </script>
  </body>
</html>
